{
  "manifest_version": 3,
  "name": "Etsy 运营增长助手",
  "version": "1.2.9",
  "minimum_chrome_version": "114",
  "description": "针对 Etsy 平台的智能店铺运营、Listing 改版、趋势研究与 Marqel 订阅鉴权工具。",
  "key": "",
  "default_locale": "zh_CN",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.etsy.com/*",
    "https://*.etsy.com/*",
    "https://*.etsystatic.com/*",
    "https://api.etsy.com/*",
    "https://openapi.etsy.com/*",
    "https://www.marqel.shop/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://openrouter.ai/*",
    "https://www.thinktv.ai/*",
    "https://api.siliconflow.cn/*",
    "https://api.groq.com/*",
    "https://github.com/*",
    "https://open.er-api.com/*",
    "https://www.google.com/*",
    "https://trends.google.com/*",
    "https://www.bing.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.au/*",
    "https://www.ebay.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.ca/*",
    "https://www.ebay.com.au/*",
    "https://www.pinterest.com/*",
    "https://trends.pinterest.com/*"
  ],
  "optional_host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/*",
        "https://*.etsy.com/*",
        "https://etsy.com/*"
      ],
      "js": ["modules/screenshotPrivacyMask.js", "modules/etsyDraftDomWriter.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
