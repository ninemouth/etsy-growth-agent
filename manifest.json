{
  "manifest_version": 3,
  "name": "Etsy 运营增长助手",
  "version": "1.2.0",
  "description": "针对 Etsy 平台的智能店铺运营、Listing 改版、趋势研究与 Marqel 订阅鉴权工具。",
  "default_locale": "zh_CN",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.etsy.com/*",
    "https://*.etsy.com/*",
    "https://*.etsystatic.com/*",
    "https://api.etsy.com/*",
    "https://openapi.etsy.com/*",
    "https://www.marqel.shop/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://openrouter.ai/*",
    "https://www.thinktv.ai/*",
    "https://api.siliconflow.cn/*",
    "https://api.groq.com/*",
    "https://github.com/*",
    "https://open.er-api.com/*",
    "https://www.google.com/*",
    "https://trends.google.com/*",
    "https://www.bing.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.au/*",
    "https://www.ebay.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.de/*",
    "https://www.ebay.fr/*",
    "https://www.ebay.ca/*",
    "https://www.ebay.com.au/*",
    "https://s.1688.com/*",
    "https://detail.1688.com/*",
    "https://sec.1688.com/*",
    "https://*.alicdn.com/*",
    "https://s.taobao.com/*",
    "https://*.taobao.com/*",
    "https://search.jd.com/*",
    "https://mobile.yangkeduo.com/*",
    "https://www.pinterest.com/*",
    "https://trends.pinterest.com/*",
    "https://www.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://www.reddit.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.etsy.com/*",
        "*://*.etsy.com/*",
        "*://etsy.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
