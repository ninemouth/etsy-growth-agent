{
  "manifest_version": 3,
  "name": "Marqel Etsy Edge",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Codex 与 Marqel Control Center 的 Etsy 浏览器现场执行、证据采集与终态回读节点。",
  "key": "",
  "default_locale": "zh_CN",
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://*.etsy.com/*",
    "https://etsy.com/*",
    "https://www.marqel.shop/*"
  ],
  "optional_host_permissions": [],
  "background": {
    "service_worker": "edge-background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/*",
        "https://*.etsy.com/*",
        "https://etsy.com/*"
      ],
      "js": ["modules/screenshotPrivacyMask.js", "modules/etsyDraftDomWriter.js", "edge-content.js"],
      "run_at": "document_end"
    }
  ]
}
